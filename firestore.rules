rules_version = '2';

// Reglas de seguridad de KeepTrack. Pegar en Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfil público: usuario y puntuaciones. Lo leen los usuarios con sesión (amigos, clasificación).
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'createdAt', 'weekPoints', 'strength', 'weekKey', 'updatedAt'])
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && validScores();

      // El nombre de usuario no se puede cambiar; las puntuaciones sí, dentro de unos límites.
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'createdAt', 'weekPoints', 'strength', 'weekKey', 'updatedAt'])
        && request.resource.data.username == resource.data.username
        && validScores();

      allow delete: if false;

      function validScores() {
        let d = request.resource.data;
        return (!('weekPoints' in d) || (d.weekPoints is int && d.weekPoints >= 0 && d.weekPoints <= 1000))
          && (!('strength' in d) || (d.strength is int && d.strength >= 0 && d.strength <= 5000))
          && (!('weekKey' in d) || d.weekKey is string);
      }

      // Amigos que has añadido: solo los ves y cambias tú.
      match /friends/{friendUid} {
        allow read, write: if isOwner(uid);
      }

      // Copia de tus datos (rutina, tareas, historial, gimnasio): privada.
      match /sync/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // Reserva de nombres de usuario: únicos y sin cambio de dueño.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_.]{3,20}$');
      allow update, delete: if false;
    }
  }
}
